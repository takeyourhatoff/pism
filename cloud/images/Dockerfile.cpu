FROM ubuntu:22.04 AS build

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libgsl-dev \
    libnetcdf-dev \
    libnetcdf-c++4-dev \
    netcdf-bin \
    libopenmpi-dev \
    libpetsc-real-dev \
    libudunits2-dev \
    openmpi-bin \
    pkg-config \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pism
COPY . /opt/pism

RUN cmake -S . -B build \
        -DCMAKE_INSTALL_PREFIX=/opt/pism-install \
        -DPism_BUILD_PYTHON_BINDINGS=OFF \
        -DPism_BUILD_TESTS=OFF \
    && cmake --build build -j$(nproc) \
    && cmake --install build --prefix /opt/pism-install

FROM ubuntu:22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libfftw3-double3 \
    libgfortran5 \
    libgsl27 \
    libhdf5-103-1 \
    libhdf5-hl-100 \
    libnetcdf19 \
    libnetcdf-c++4-1 \
    libopenmpi3 \
    openmpi-bin \
    libpetsc-real3.15 \
    libquadmath0 \
    libudunits2-0 \
    libxml2 \
    python3 \
    awscli \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/pism-cloud
COPY cloud/images/run_job.py /opt/pism-cloud/run_job.py

COPY --from=build /opt/pism-install /opt/pism-install

ENV PATH="/opt/pism-install/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/pism-install/lib"

WORKDIR /workspace
