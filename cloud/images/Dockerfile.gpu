FROM nvidia/cuda:12.2.0-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG CUDA_ARCH=sm_86

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    libgsl-dev \
    libnetcdf-dev \
    libnetcdf-c++4-dev \
    libopenmpi-dev \
    openmpi-bin \
    pkg-config \
    python3 \
    awscli \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone -b release --depth=1 https://gitlab.com/petsc/petsc.git

WORKDIR /opt/petsc
RUN ./configure \
      --prefix=/opt/petsc \
      --with-cc=mpicc \
      --with-cxx=mpicxx \
      --with-fc=mpifort \
      --with-shared-libraries \
      --with-debugging=0 \
      --with-x=0 \
      --with-cuda=1 \
      --with-cudac=/usr/local/cuda/bin/nvcc \
      --with-cuda-arch=${CUDA_ARCH} \
      --download-f2cblaslapack \
    && make all -j$(nproc) \
    && make install

ENV PETSC_DIR=/opt/petsc
ENV PETSC_ARCH=""
ENV PATH="/opt/petsc/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/petsc/lib:${LD_LIBRARY_PATH}"

WORKDIR /opt/pism
COPY . /opt/pism

RUN cmake -S . -B build \
        -DPism_BUILD_PYTHON_BINDINGS=OFF \
        -DPism_BUILD_TESTS=OFF \
        -DPism_USE_CUDA_SIA=ON \
    && cmake --build build -j$(nproc) \
    && cmake --install build --prefix /opt/pism-install

ENV PATH="/opt/pism-install/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/pism-install/lib:${LD_LIBRARY_PATH}"

WORKDIR /workspace
